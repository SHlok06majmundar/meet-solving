NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
# Clerk backend secret or PEM public key. Never expose these as VITE_ variables.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional AI providers. Browser captions and local insights work without these.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Configure your own coturn server with use-auth-secret and the same shared secret.
TURN_URLS=
TURN_SHARED_SECRET=
# Alternative: Metered/Open Relay account credentials (backend only).
# Use this pair instead of TURN_URLS + TURN_SHARED_SECRET.
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
MAX_PARTICIPANTS=12
# Exact number of reverse proxy hops; leave 0 when connecting directly.
TRUST_PROXY_HOPS=0
